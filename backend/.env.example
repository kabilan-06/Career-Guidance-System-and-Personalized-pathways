# Spring datasource (PostgreSQL / Supabase / Neon)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=86400000

# Local FastAPI AI service (resume analysis + semantic job matching)
# Start it from the ai-service/ directory on port 8000; no external AI provider is used.
NLP_SERVICE_URL=http://localhost:8000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_ANALYZE_ENDPOINT=/api/resume/analyze

# Groq-powered AI assessment generation (admin feature).
# Leave empty to disable; the endpoint then returns 503 SERVICE_UNAVAILABLE.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
